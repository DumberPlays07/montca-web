---
import type { ImageMetadata } from 'astro';
import { Font, getImage } from 'astro:assets';
import BarraInferior from '../components/BarraInferior.astro';
import BotonWhatsApp from '../components/BotonWhatsApp.astro';
import Cabecera from '../components/Cabecera.astro';
import Pie from '../components/Pie.astro';
import { type TextoAlternativo, exigirTextoAlternativo } from '../components/imagenes';
import { ruta } from '../components/textos-navegacion';
import { TIPO_VUELO, activarVuelo, vieneDelMapa } from '../lib/vuelo';
import '../styles/global.css';

interface Props {
	title: string;
	description: string;
	/**
	 * Imagen que se ve al compartir la página: importada de `src/assets`, nunca una ruta de
	 * `public/`. Si la página no tiene una propia, usa `IMAGEN_COMPARTIR_POR_DEFECTO`.
	 */
	image: ImageMetadata;
	/** Texto alternativo de la imagen para compartir, en los dos idiomas. */
	imageAlt: TextoAlternativo;
	lang?: 'ca' | 'es';
}

const { title, description, image, imageAlt, lang = 'ca' } = Astro.props;

// `astro build` no comprueba los tipos de las props, así que una página sin estos
// datos se publicaría sin avisar. Se corta aquí para que el build falle.
const requiredTexts = { title, description };
for (const [name, value] of Object.entries(requiredTexts)) {
	if (typeof value !== 'string' || value.trim() === '') {
		throw new Error(
			`BaseLayout: falta "${name}" en la página ${Astro.url.pathname}. ` +
				'Cada página necesita title, description, image e imageAlt.',
		);
	}
}
if (typeof image !== 'object' || image === null || typeof image.width !== 'number') {
	throw new Error(
		`BaseLayout: falta "image" en la página ${Astro.url.pathname}, o no es una imagen ` +
			'importada de src/assets. Usa IMAGEN_COMPARTIR_POR_DEFECTO si la página no tiene una propia.',
	);
}
exigirTextoAlternativo(imageAlt, `la imagen para compartir de ${Astro.url.pathname}`);

// Proporción que recomiendan las redes para compartir (1200 × 630 ≈ 1,91:1).
const ANCHO_COMPARTIR = 1200;
const PROPORCION_COMPARTIR = 1200 / 630;
// No se amplía: con una imagen de menos de 1200 px de ancho se usa su ancho
// y se recorta a la misma proporción (por ejemplo, 1024 × 538).
const anchoCompartir = Math.min(
	ANCHO_COMPARTIR,
	image.width,
	Math.floor(image.height * PROPORCION_COMPARTIR),
);
const altoCompartir = Math.round(anchoCompartir / PROPORCION_COMPARTIR);
const imagenCompartir = await getImage({
	src: image,
	width: anchoCompartir,
	height: altoCompartir,
	fit: 'cover',
	format: 'jpg',
});

// Las redes sociales necesitan la URL completa de la imagen, no una ruta relativa.
// TODO: definir `site` en astro.config.mjs cuando exista el dominio (A-11); hasta
// entonces la URL sale con el host local y no sirve para compartir de verdad.
const imageUrl = new URL(imagenCompartir.src, Astro.site ?? Astro.url).href;

// Las dos funciones del vuelo se publican tal cual (`.toString()`): no pueden usar nada de fuera de su cuerpo.
const configuracionVuelo = { tipo: TIPO_VUELO, inicios: [ruta('ca', 'inicio'), ruta('es', 'inicio')] };
const scriptVuelo = `(${activarVuelo})(window, ${JSON.stringify(configuracionVuelo)}, ${vieneDelMapa});`;
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<!-- viewport-fit=cover: la barra inferior respeta la zona segura del móvil con env(). -->
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<Font cssVariable="--font-overpass" preload />
		<!--
			Vuelo del mapa (B-19): al pulsar "Entra" en la viñeta, el punto del botón viaja hasta el título de la
			página nueva. La lógica y su explicación están en `src/lib/vuelo.ts` (con sus pruebas); este script solo
			la publica. Va aquí, en la cabecera y sin ser un módulo, porque `pagereveal` se dispara antes del primer
			pintado de la página nueva y un módulo (diferido) podría llegar tarde. No guarda nada en el navegador.
		-->
		<script is:inline set:html={scriptVuelo}></script>
		<link rel="icon" type="image/png" sizes="192x192" href="/favicon.png" />
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<meta name="description" content={description} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={imageUrl} />
		<meta property="og:image:type" content="image/jpeg" />
		<meta property="og:image:width" content={String(anchoCompartir)} />
		<meta property="og:image:height" content={String(altoCompartir)} />
		<meta property="og:image:alt" content={imageAlt[lang]} />
		<title>{title}</title>
		<slot name="head" />
	</head>
	<body>
		<Cabecera lang={lang} />
		<div id="contenido" class="contenido" tabindex="-1">
			<slot />
		</div>
		<BotonWhatsApp lang={lang} />
		<Pie lang={lang} />
		<BarraInferior lang={lang} />
	</body>
</html>
