---
/**
 * Mapa de Mariola como menú de la web (B-21): la ilustración con siete botones, cada uno con su
 * placa siempre visible y una viñeta que lleva al apartado, y debajo la lista de los mismos siete
 * destinos como enlaces directos. Cambia el concepto del 14/11 (un punto por actividad):
 * decisión del 25/11 en `docs/decisiones.md`; propuesta en el issue #108.
 *
 * - **Los datos** (posición, lado de la placa, ruta y textos en los dos idiomas) están en
 *   `src/data/destinos-mapa.json`; la lógica, en `src/lib/mapa.ts`. Los picos toman sus coordenadas
 *   de `picos-mapa.json`; los demás picos del dibujo no tienen botón.
 * - **Capas** dentro de `.mapa`, todas en % del recorte: `.lienzo` (lo que B-19 escalará para el zoom)
 *   envuelve `.recorte` (la imagen), `.escena` (vacía en B-21, para B-22) y `.botones`. La viñeta, el
 *   aviso y los degradados quedan fuera del lienzo para que no se escalen.
 * - **Pensado para B-19 y B-22 (sin animar nada aquí):** cada botón se centra con `translate` y no con
 *   `transform`, y lleva `--x`, `--y` y `--orden`; el punto y la placa son elementos separados; el
 *   enlace de la viñeta lleva `data-destino`; los estados van en `aria-expanded` y `hidden` (que pone el script).
 * - **En el móvil el mapa mide 56rem y se desliza** dentro de su marco, con degradado en los bordes y
 *   un aviso que desaparece al primer deslizamiento. Empieza centrado en el 76 % del ancho.
 * - **La viñeta** es una sola para todos los botones y la rellena `mapa-mariola-cliente.ts`: panel
 *   encima de la barra inferior en el móvil y tarjeta con piquito junto al botón en escritorio.
 *
 * Sin JavaScript cada botón del mapa es un enlace directo a su apartado y no sale la viñeta; el script
 * los convierte en botones que abren la viñeta (`mapa-mariola-cliente.ts`).
 */
import Icono from './Icono.astro';
import Foto from './Foto.astro';
import { type ClaveRuta, type Idioma, ruta, textoEnLosDosIdiomas } from './textos-navegacion';
import { t } from './textos-portada';
import mapa from '../assets/mapa/mapa-mariola.webp';
import destinosEnCrudo from '../data/destinos-mapa.json';
import picosEnCrudo from '../data/picos-mapa.json';
import {
	ANCHO_MINIMO_MAPA_REM,
	CENTRO_INICIAL_MARCO,
	type DestinoEnCrudo,
	RECORTE_SUPERIOR,
	FUNDIDO_INFERIOR_DESDE,
	FUNDIDO_INFERIOR_HASTA,
	FUNDIDO_SUPERIOR,
	RECORTE_INFERIOR,
	formatoAltura,
	prepararDestinos,
	prepararPicos,
	proporcionRecortada,
} from '../lib/mapa';

interface Props {
	lang: Idioma;
}

const { lang } = Astro.props;

const destinosPreparados = prepararDestinos(destinosEnCrudo as DestinoEnCrudo[], picosEnCrudo);
const destinos = destinosPreparados.map((destino) => ({
	...destino,
	href: ruta(lang, destino.ruta as ClaveRuta),
	texto: destino.textos[lang],
}));
// Los demás picos del dibujo: puntos pequeños con ficha de nombre y altura, sin placa ni apartado.
const picos = prepararPicos(picosEnCrudo, destinosPreparados, mapa.width, mapa.height, destinosEnCrudo as DestinoEnCrudo[]);
const proporcion = proporcionRecortada(mapa.width, mapa.height);
const visible = 1 - RECORTE_SUPERIOR - RECORTE_INFERIOR;
---

<section class="mapa-mariola" data-mapa-mariola data-escena-estado="hecha">
	<h2 class="solo-lector">{t(lang, 'mapaTitulo')}</h2>
	<div class="caja" data-caja>
		<div
			class="marco"
			data-marco
			data-centro-x={CENTRO_INICIAL_MARCO * 100}
			role="group"
			aria-label={t(lang, 'regionMapa')}
			style={`--ancho-minimo: ${ANCHO_MINIMO_MAPA_REM}rem`}
		>
			<div class="mapa" style={`--proporcion: ${proporcion}; --recorte-arriba: ${RECORTE_SUPERIOR}; --recorte-visible: ${visible}; --fundido-arriba: ${Math.round(FUNDIDO_SUPERIOR * 100)}%; --fundido-abajo-desde: ${Math.round(FUNDIDO_INFERIOR_DESDE * 100)}%; --fundido-abajo-hasta: ${Math.round(FUNDIDO_INFERIOR_HASTA * 100)}%`}>
				<div class="lienzo" data-lienzo>
					<div class="recorte">
						<Foto
							src={mapa}
							alt={textoEnLosDosIdiomas('altImagenCompartir')}
							lang={lang}
							principal
							sizes={`(min-width: 72rem) 1152px, max(100vw, ${ANCHO_MINIMO_MAPA_REM}rem)`}
						/>
					</div>

					<!-- Vacía en B-21: B-22 pone aquí la boira, los pájaros y los excursionistas, por debajo de los botones. -->
					<div class="escena" data-escena aria-hidden="true"></div>

					<div class="botones">
						{
							destinos.map((destino) => (
								<a
									class="boton"
									href={destino.href}
									style={`--x: ${destino.izquierda}%; --y: ${destino.arriba}%; --orden: ${destino.orden}`}
									data-id={destino.id}
									data-lugar={destino.texto.lugar}
									data-altura={destino.altura !== undefined ? formatoAltura(destino.altura) : undefined}
									data-titulo={destino.texto.titulo}
									data-frase={destino.texto.frase}
									data-destino={destino.ruta}
									aria-label={`${destino.texto.nombre}: ${destino.texto.placaDestino}`}
								>
									<span class="punto" aria-hidden="true" />
									<span class="placa" data-lado={destino.lado} style={`--desplazamiento: ${destino.desplazamiento}px`} aria-hidden="true">
										<span class="marca" />
										{destino.texto.placaDestino}
									</span>
								</a>
							))
						}
						{
							picos.map((pico) => (
								<span
									class="pico"
									style={`--x: ${pico.izquierda}%; --y: ${pico.arriba}%; --vecino: ${pico.vecino}; --vecino-boton: ${pico.vecinoBoton}`}
									data-id={pico.id}
									data-nombre={pico.nombre}
									data-altura={formatoAltura(pico.altura)}
								>
									<span class="punto-pico" aria-hidden="true" />
									<span class="etiqueta" aria-hidden="true">
										{pico.nombre}
									</span>
								</span>
							))
						}
					</div>
				</div>
			</div>
		</div>

		<!-- Degradados de los bordes con más mapa y aviso de deslizar: solo en el móvil y solo con JS. -->
		<span class="borde borde-izquierdo" aria-hidden="true"></span>
		<span class="borde borde-derecho" aria-hidden="true"></span>
		<p class="pista" data-pista hidden>{t(lang, 'llisca')}</p>

		<div
			class="vineta"
			id="vineta-mapa"
			role="dialog"
			aria-modal="false"
			aria-labelledby="titulo-vineta"
			tabindex="-1"
			data-vineta
			hidden
		>
			<h3 id="titulo-vineta">
				<span data-vineta-lugar></span>
				<span class="con-altura" data-vineta-con-altura hidden>
					<span class="punt" aria-hidden="true"></span><span class="solo-lector">, </span><span data-vineta-altura></span>
				</span>
			</h3>
			<p class="vineta-destino"><span class="marca" aria-hidden="true"></span><span data-vineta-titulo></span></p>
			<p class="vineta-frase" data-vineta-frase></p>
			<a class="entra" data-vineta-enlace data-destino="" href={ruta(lang, 'inicio')} data-conector={t(lang, 'entraConector')}>
				{t(lang, 'entra')}
				<Icono nombre="seguir" />
				<span class="solo-lector" data-vineta-solo-lector></span>
			</a>
			<!-- Al final del DOM para que el tabulador pase primero por "Entra" y después por "Tanca". -->
			<button type="button" class="cerrar" data-cerrar aria-label={t(lang, 'cerrarVineta')}>
				<Icono nombre="cerrar" />
			</button>
		</div>

		<!-- Ficha de los demás picos: nombre y altura, sin apartado al que ir. -->
		<div
			class="vineta ficha"
			id="ficha-pico"
			role="dialog"
			aria-modal="false"
			aria-labelledby="titulo-ficha"
			tabindex="-1"
			data-ficha
			hidden
		>
			<h3 id="titulo-ficha">
				<span data-ficha-nombre></span>
				<span class="con-altura">
					<span class="punt" aria-hidden="true"></span><span class="solo-lector">, </span><span data-ficha-altura></span>
				</span>
			</h3>
			<button type="button" class="cerrar" data-cerrar aria-label={t(lang, 'cerrarVineta')}>
				<Icono nombre="cerrar" />
			</button>
		</div>
	</div>

	<!-- Entre el mapa y la lista: los accesos de la portada. -->
	<slot />

	<nav class="destinos" aria-labelledby="titulo-destinos">
		<h2 id="titulo-destinos">{t(lang, 'destinosTitulo')}</h2>
		<ul class="lista-destinos">
			{
				destinos.map((destino) => (
					<li>
						<a class="destino" href={destino.href}>
							<span class="nombre-destino">{destino.texto.titulo}</span>
							<span class="lugar-destino">{destino.texto.nombre}</span>
						</a>
					</li>
				))
			}
		</ul>
	</nav>
</section>

<script>
	import '../scripts/mapa-mariola-cliente';
</script>

<style>
	.mapa-mariola {
		display: grid;
		gap: var(--espacio-8);
		/* Lo que mide el punto de cada botón y lo que la placa se mete en su zona (src/lib/mapa.ts). */
		--solape-placa: 6px;
	}

	.caja {
		position: relative;
	}

	/* ---- Marco: en el móvil, el mapa se desliza dentro de él, de borde a borde de la pantalla. ---- */
	.marco {
		overflow-x: auto;
		overscroll-behavior-x: contain;
		margin-inline: calc(-1 * var(--margen-lateral));
		scrollbar-width: thin;
	}

	.mapa {
		position: relative;
		width: max(100%, var(--ancho-minimo));
	}

	/* El lienzo es lo que B-19 escalará para el zoom hacia el botón: lleva la imagen, la escena y los
	   botones, todos con el mismo sistema de coordenadas (% del recorte). */
	.lienzo {
		position: relative;
	}

	/* Recorte (src/lib/mapa.ts): se enseña solo una franja de la imagen. La máscara difumina el borde
	   de arriba, el de abajo (el corte frontal del diorama) y los de los lados para que la ilustración se
	   funda con el fondo Boira de la página (DESIGN.md: el fondo es el cielo del mapa); no separa zonas.
	   No afecta a los botones, que están fuera del recorte, y la franja de abajo queda libre de botones,
	   placas y picos (`FUNDIDO_INFERIOR_DESDE`). De cada color de la máscara solo cuenta que es opaco. */
	.recorte {
		position: relative;
		overflow: hidden;
		aspect-ratio: var(--proporcion);
		-webkit-mask-image:
			linear-gradient(to right, transparent, var(--color-tinta) 5%, var(--color-tinta) 95%, transparent),
			linear-gradient(
				to bottom,
				transparent,
				var(--color-tinta) var(--fundido-arriba),
				var(--color-tinta) calc(100% - var(--fundido-abajo-desde)),
				transparent calc(100% - var(--fundido-abajo-hasta))
			);
		-webkit-mask-composite: source-in;
		mask-image:
			linear-gradient(to right, transparent, var(--color-tinta) 5%, var(--color-tinta) 95%, transparent),
			linear-gradient(
				to bottom,
				transparent,
				var(--color-tinta) var(--fundido-arriba),
				var(--color-tinta) calc(100% - var(--fundido-abajo-desde)),
				transparent calc(100% - var(--fundido-abajo-hasta))
			);
		mask-composite: intersect;
	}

	.recorte :global(picture) {
		position: absolute;
		top: calc(var(--recorte-arriba) / var(--recorte-visible) * -100%);
		left: 0;
		width: 100%;
	}

	/* Escena (B-22): encima de la imagen y por debajo de los botones; nunca recibe clics. */
	.escena,
	.botones {
		position: absolute;
		inset: 0;
		pointer-events: none;
	}

	/* ---- Botones: zona de 44 px con el punto en el centro y la placa pegada a un lado. ---- */
	.boton {
		position: absolute;
		left: var(--x);
		top: var(--y);
		display: grid;
		place-items: center;
		width: var(--zona-tactil);
		height: var(--zona-tactil);
		padding: 0;
		background: none;
		border: 0;
		color: var(--color-tinta);
		font: inherit;
		text-decoration: none;
		cursor: pointer;
		pointer-events: auto;
		/* Por encima de los picos: donde sus zonas se solapan, manda el botón de destino. */
		z-index: 2;
		/* `translate` y no `transform`: así B-19 puede escalar y levantar el botón sin descolocarlo. */
		translate: -50% -50%;
	}

	/* Punto: 20 px de amarillo, anillo Verd bosc de 3 px y halo Blanco de 2 px; el borde llega a 3:1
	   sobre cualquier zona del mapa (DESIGN.md, Groc sender). */
	.punto {
		box-sizing: content-box;
		width: 20px;
		height: 20px;
		background: var(--color-groc-sender);
		border: 3px solid var(--color-verd-bosc);
		border-radius: 50%;
		box-shadow: 0 0 0 2px var(--color-blanco);
	}

	/* Seleccionado: solo cambia el color del anillo (sin escala, para que B-19 pueda añadirla). */
	.boton[aria-expanded='true'] .punto {
		border-color: var(--color-tinta);
	}

	/* Foco en dos tonos (Boira y Tinta) alrededor del punto y de la placa. */
	.boton:focus-visible {
		outline: none;
	}

	.boton:focus-visible .punto {
		box-shadow:
			0 0 0 2px var(--color-blanco),
			0 0 0 5px var(--color-boira),
			0 0 0 8px var(--color-tinta);
	}

	.boton:focus-visible .placa {
		box-shadow:
			0 0 0 3px var(--color-boira),
			0 0 0 6px var(--color-tinta);
	}

	/* ---- Placa de sendero: una línea con el destino, siempre visible y pulsable como parte del botón. ---- */
	.placa {
		position: absolute;
		display: flex;
		align-items: center;
		gap: 6px;
		min-height: 24px;
		padding: 2px 8px 2px 6px;
		background: var(--color-boira);
		border: 1px solid var(--color-linea);
		border-radius: var(--radio-senal);
		color: var(--color-verd-bosc);
		font-size: 0.875rem;
		font-weight: 600;
		letter-spacing: 0.02em;
		line-height: 1.25;
		white-space: nowrap;
	}

	.placa[data-lado='arriba'] {
		bottom: calc(100% - var(--solape-placa));
		left: 50%;
		translate: calc(-50% + var(--desplazamiento, 0px)) 0;
	}

	.placa[data-lado='abajo'] {
		top: calc(100% - var(--solape-placa));
		left: 50%;
		translate: calc(-50% + var(--desplazamiento, 0px)) 0;
	}

	.placa[data-lado='derecha'] {
		top: 50%;
		left: calc(100% - var(--solape-placa));
		translate: 0 calc(-50% + var(--desplazamiento, 0px));
	}

	.placa[data-lado='izquierda'] {
		top: 50%;
		right: calc(100% - var(--solape-placa));
		translate: 0 calc(-50% + var(--desplazamiento, 0px));
	}

	/* Con la viñeta abierta, la placa ya está en la viñeta y taparía su borde. El nombre del botón no
	   cambia porque va en `aria-label`. */
	.boton[aria-expanded='true'] .placa {
		visibility: hidden;
	}

	@media (hover: hover) and (pointer: fine) {
		.boton:hover .placa {
			text-decoration: underline;
			text-decoration-thickness: 2px;
		}
	}

	/* Marca de sendero: punto de 10 px con el anillo Verd bosc de 2 px por dentro (Trail Mark Rule). */
	.marca {
		flex: none;
		display: inline-block;
		width: 10px;
		height: 10px;
		background: var(--color-groc-sender);
		border: 2px solid var(--color-verd-bosc);
		border-radius: 50%;
	}

	/* ---- Picos sin destino: punto pequeño con su ficha de nombre y altura. Sin placa, sin amarillo. ---- */
	.pico {
		position: absolute;
		left: var(--x);
		top: var(--y);
		display: grid;
		place-items: center;
		/* Zona pulsable: 44 px, o menos si otro pico, o la mitad de la zona de un botón, está más cerca;
		   nunca menos de 24 px (excepción del principio V, docs/decisiones.md). */
		width: clamp(24px, min(calc(var(--vecino) * 100%), calc(2 * (var(--vecino-boton) * 100% - 22px))), 44px);
		aspect-ratio: 1;
		border-radius: 50%;
		color: var(--color-tinta);
		pointer-events: auto;
		z-index: 1;
		translate: -50% -50%;
	}

	.punto-pico {
		width: 14px;
		height: 14px;
		background: var(--color-boira);
		border: 2px solid var(--color-verd-bosc);
		border-radius: 50%;
	}

	/* Los picos solo se comportan como botones cuando el script ha cargado (`.con-js` en la raíz del mapa):
	   sin JavaScript no abren nada y no deben parecerlo. */
	.con-js .pico {
		cursor: pointer;
	}

	.con-js .pico:hover .punto-pico,
	.pico[aria-expanded='true'] .punto-pico {
		width: 18px;
		height: 18px;
		border-width: 3px;
	}

	.pico[aria-expanded='true'] .punto-pico {
		background: var(--color-teula-clara);
		border-color: var(--color-tinta);
	}

	.pico:focus-visible {
		outline: none;
	}

	.pico:focus-visible .punto-pico {
		box-shadow:
			0 0 0 3px var(--color-boira),
			0 0 0 6px var(--color-tinta);
	}

	/* El nombre del pico aparece al pasar el ratón o al enfocarlo. */
	.etiqueta {
		position: absolute;
		left: 100%;
		top: 50%;
		display: none;
		margin-left: var(--espacio-1);
		padding: 0 var(--espacio-2);
		background: var(--color-boira);
		border-radius: var(--radio-senal);
		font-size: 0.875rem;
		font-weight: 600;
		line-height: 1.5;
		white-space: nowrap;
		pointer-events: none;
		translate: 0 -50%;
	}

	.con-js .pico:hover .etiqueta,
	.pico:focus-visible .etiqueta {
		display: block;
		z-index: 3;
	}

	.pico[aria-expanded='true'] .etiqueta {
		display: none;
	}

	/* ---- Móvil: degradados de los bordes y aviso de deslizar. ---- */
	.borde {
		position: absolute;
		top: 0;
		bottom: 0;
		display: none;
		width: 2.5rem;
		pointer-events: none;
	}

	.borde-izquierdo {
		left: calc(-1 * var(--margen-lateral));
		background: linear-gradient(
			to right,
			color-mix(in srgb, var(--color-boira) 95%, transparent),
			color-mix(in srgb, var(--color-boira) 0%, transparent)
		);
	}

	.borde-derecho {
		right: calc(-1 * var(--margen-lateral));
		background: linear-gradient(
			to left,
			color-mix(in srgb, var(--color-boira) 95%, transparent),
			color-mix(in srgb, var(--color-boira) 0%, transparent)
		);
	}

	.caja[data-borde-izquierdo='si'] .borde-izquierdo,
	.caja[data-borde-derecho='si'] .borde-derecho {
		display: block;
	}

	.pista {
		position: absolute;
		left: 50%;
		/* Arriba y no abajo: en móviles bajos la barra inferior taparía el aviso. */
		top: var(--espacio-3);
		margin: 0;
		padding: var(--espacio-2) var(--espacio-3);
		background: var(--color-boira);
		border: 1px solid var(--color-linea);
		border-radius: var(--radio-senal);
		color: var(--color-verd-bosc);
		font-size: 0.875rem;
		font-weight: 600;
		white-space: nowrap;
		pointer-events: none;
		transform: translateX(-50%);
	}

	.pista[hidden] {
		display: none;
	}

	/* ---- Viñeta: panel inferior en el móvil, encima de la barra inferior. ---- */
	.vineta {
		position: fixed;
		right: 0;
		bottom: calc(var(--alto-barra-inferior) + env(safe-area-inset-bottom));
		left: 0;
		z-index: 15;
		max-height: 60vh;
		overflow-y: auto;
		padding: var(--espacio-4) var(--margen-lateral) var(--espacio-6);
		background: var(--color-boira);
		border-top: 1px solid var(--color-linea);
		border-radius: var(--radio-boton) var(--radio-boton) 0 0;
		/* La única sombra de la web (`--sombra-panel`): separa este panel del mapa (DESIGN.md, Elevation). */
		box-shadow: var(--sombra-panel);
	}

	.vineta[hidden] {
		display: none;
	}

	.vineta:focus {
		outline: none;
	}

	/* El destino va debajo del nombre del sitio, más pequeño y con la marca de sendero delante. */
	.vineta-destino {
		display: flex;
		align-items: center;
		gap: 6px;
		margin: var(--espacio-1) 0 0;
		padding-right: var(--zona-tactil);
		color: var(--color-verd-bosc);
		font-size: 0.875rem;
		font-weight: 600;
		line-height: 1.4;
	}

	.vineta h3 > span {
		white-space: nowrap;
	}

	/* Punto flotante dibujado con CSS entre el nombre y la altura (DESIGN.md, Floating Dot Rule). */
	.punt {
		display: inline-block;
		width: 0.14em;
