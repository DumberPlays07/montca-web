---
/**
 * Preguntas frecuentes de un evento (C-04, FR-008): un `<details>` por pregunta, que se
 * abre con el teclado y lo anuncian los lectores de pantalla sin JavaScript.
 * Si el evento no trae preguntas, no sale nada.
 */
import type { DatosEvento } from './tipos';
import type { Idioma } from '../textos-navegacion';
import { t } from '../textos-eventos';

interface Props {
	lang: Idioma;
	preguntas: DatosEvento['preguntas'];
}

const { lang, preguntas = [] } = Astro.props;
---

{
	preguntas.length > 0 && (
		<section class="preguntes" aria-labelledby="titol-preguntes">
			<h2 id="titol-preguntes">{t(lang, 'preguntesFrequents')}</h2>
			<div class="llista">
				{preguntas.map((item) => (
					<details>
						<summary>{item.pregunta[lang]}</summary>
						<p>{item.respuesta[lang]}</p>
					</details>
				))}
			</div>
		</section>
	)
}

<style>
	h2 {
		margin: 0 0 var(--espacio-4);
		font-size: clamp(1.5rem, 1.25rem + 1vw, 2rem);
	}

	.llista {
		border-top: 1px solid var(--color-linea);
	}

	details {
		border-bottom: 1px solid var(--color-linea);
	}

	/* Cada pregunta es una fila de al menos 44 px con un "+" que pasa a "−" al abrirse. */
	summary {
		position: relative;
		display: flex;
		align-items: center;
		min-height: var(--zona-tactil);
		padding: var(--espacio-2) var(--espacio-8) var(--espacio-2) 0;
		color: var(--color-verd-bosc);
		font-size: 1.125rem;
		font-weight: 600;
		line-height: 1.35;
		list-style: none;
		cursor: pointer;
	}

	summary::-webkit-details-marker {
		display: none;
	}

	summary::before,
	summary::after {
		content: '';
		position: absolute;
		top: 50%;
		right: var(--espacio-2);
		width: 0.875rem;
		height: 2px;
		background: currentColor;
	}

	summary::after {
		transform: rotate(90deg);
	}

	details[open] > summary::after {
		display: none;
	}

	summary:hover {
		text-decoration: underline;
		text-decoration-thickness: 2px;
	}

	details p {
		max-width: 65ch;
		margin: 0;
		padding: 0 0 var(--espacio-4);
	}
</style>
