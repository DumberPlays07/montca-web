---
/**
 * Cuenta atrás de la portada (B-13): cuánto falta para la primera jornada del próximo evento.
 *
 * La franja de la portada habla de las inscripciones; esta pieza, de cuándo empieza. Por eso no
 * lleva botón de inscripción ni el plazo, y es un enlace discreto a la página del evento.
 *
 * Al construir elige el próximo evento (`eventosProximos`) y calcula la cuenta con la hora de
 * Madrid. En el navegador, `cuenta-atras-cliente.ts` la recalcula cada segundo (cada minuto, y sin
 * segundos, con movimiento reducido), sin volver a publicar. Sin evento con fecha sale "Properament",
 * sin enlace.
 *
 * Accesibilidad: las casillas que cambian llevan `aria-hidden`; el lector de pantalla oye una frase
 * fija ("Falten 32 dies") que solo cambia al cambiar de día. No hay `aria-live`.
 */
import { getCollection } from 'astro:content';
import { calcularCuentaAtras, casillasCuenta } from '../../lib/eventos/cuenta-atras';
import { numeralJornada } from '../../lib/eventos/fechas';
import { eventosProximos } from '../../lib/eventos/lista';
import { textosCuentaAtras } from '../cuenta-atras-textos';
import Icono from '../Icono.astro';
import { type Idioma, ruta } from '../textos-navegacion';
import { t } from '../textos-portada';

interface Props {
	lang: Idioma;
}

const { lang } = Astro.props;

const eventos = (await getCollection('eventos')).map((entrada) => ({ id: entrada.id, ...entrada.data }));
const ahora = new Date();
const evento = eventosProximos(eventos, ahora)[0] ?? null;
const cuenta = calcularCuentaAtras(evento, ahora);
// Sin evento, o con uno que ya terminó, no hay enlace ni nombre: solo "Properament".
const hayEvento = evento !== null && cuenta.tipo !== 'proximament';

const inicio = evento?.jornadas[0].fecha ?? '';
const { dia, mes } = inicio === '' ? { dia: '', mes: '' } : numeralJornada(inicio);
const horaInicio = evento?.jornadas[0].hora;
const textos = textosCuentaAtras(lang, cuenta, `${dia}/${mes}`, horaInicio);
// Con la cuenta visible, las casillas; con una palabra ("Hui"), no hay nada que pintar en ellas.
const casillas = casillasCuenta(cuenta.tipo === 'cuenta' ? cuenta : { tipo: 'cuenta', dias: 0, horas: 0, minutos: 0, segundos: 0 });
const unidades = [
	{ clave: 'dias', unidad: t(lang, 'cuentaUnidadDias') },
	{ clave: 'horas', unidad: t(lang, 'cuentaUnidadHoras') },
	{ clave: 'minutos', unidad: t(lang, 'cuentaUnidadMinutos') },
	{ clave: 'segundos', unidad: t(lang, 'cuentaUnidadSegundos') },
] as const;

const Etiqueta = hayEvento ? 'a' : 'div';
---

<Etiqueta
	class="cuenta"
	href={hayEvento ? `${ruta(lang, 'eventos')}${evento.id}/` : undefined}
	data-cuenta-atras
	data-tipo={cuenta.tipo}
	data-lang={lang}
	data-inicio={inicio}
	data-hora={horaInicio}
	data-fin={evento?.jornadas[evento.jornadas.length - 1].fecha ?? ''}
>
	<span class="datos">
		<span class="marca">
			{/* El punto va pegado a la marca: si el nombre baja de línea, el punto no se queda solo al principio. */}
			<span class="grupo-marca">
				<span data-marca>{hayEvento ? evento.marca : t(lang, 'cuentaMarcaFija')}</span>
				{hayEvento && (
					<span class="separador" data-nombre-evento>
						<span class="punt" aria-hidden="true" />
						<span class="solo-lector">, </span>
					</span>
				)}
			</span>
			{hayEvento && <span data-nombre-evento>{evento.nombre[lang]}</span>}
		</span>
		<span class="cifra">
			<span class="solo-lector" data-frase>{textos.frase}</span>
			<span class="valor" data-valor>{textos.valor}</span>
			<span class="casillas" aria-hidden="true">
				{
					unidades.map(({ clave, unidad }) => (
						<span class={`casilla casilla-${clave}`}>
							<span class="numero" data-casilla={clave}>
								{casillas[clave]}
							</span>
							<span class="unidad">{unidad}</span>
						</span>
					))
				}
			</span>
		</span>
		<span class="detalle" data-detalle>{textos.detalle}</span>
	</span>
	<Icono nombre="seguir" clase="flecha" />
</Etiqueta>

<script>
	import '../../scripts/cuenta-atras-cliente';
</script>

<style>
	/* Plano Pedra (DESIGN.md, Tertiary): superficie cálida puntual, sin sombra ni degradado. */
	.cuenta {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--espacio-4);
		min-height: var(--zona-tactil);
		padding: var(--espacio-4);
		margin-bottom: var(--espacio-3);
		background: var(--color-pedra);
		color: var(--color-tinta);
		border-radius: var(--radio-boton);
		text-decoration: none;
		transition: background-color var(--transicion);
	}

	.cuenta[href]:hover {
		background: var(--color-herba-clara);
	}

	.datos {
		display: grid;
		gap: var(--espacio-1);
	}

	/* Verd bosc y no Verd fulla: sobre Pedra el texto pequeño en Verd fulla no llega a 4,5:1. */
	.marca {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		color: var(--color-verd-bosc);
		font-size: 0.875rem;
		font-weight: 600;
		letter-spacing: 0.02em;
	}

	.grupo-marca {
		display: inline-flex;
		align-items: center;
		white-space: nowrap;
	}

	.separador {
		display: inline-flex;
		align-items: center;
	}

	/* Punto volado dibujado con CSS: el "·" de Overpass se dibuja con un espaciado raro. */
	.punt {
		flex-shrink: 0;
		width: 0.14em;
		height: 0.14em;
		margin: 0 0.5em;
		background: currentColor;
	}

	/* Las palabras ("Hui", "Properament") van en Headline; con la cuenta visible, las casillas. */
	.valor {
		color: var(--color-verd-bosc);
		font-size: clamp(1.5rem, 1.25rem + 1vw, 2rem);
		font-weight: 800;
		line-height: 1.15;
		letter-spacing: -0.02em;
		text-wrap: balance;
	}

	.valor:empty,
	[data-tipo='cuenta'] .valor,
	[data-tipo]:not([data-tipo='cuenta']) .casillas {
		display: none;
	}

	/* Cuatro casillas de ancho igual: con cifras tabulares y dos cifras mínimas, nada se mueve al cambiar. */
	.casillas {
		display: grid;
		grid-auto-flow: column;
		grid-auto-columns: minmax(min-content, 1fr);
		color: var(--color-verd-bosc);
	}

	.casilla {
		display: grid;
		gap: var(--espacio-1);
		padding-inline: var(--espacio-2);
		border-inline-start: 1px solid var(--color-linea);
	}

	.casilla:first-child {
		padding-inline-start: 0;
		border-inline-start: 0;
	}

	/* Numeral (DESIGN.md), un peldaño más pequeño: cuatro números tienen que caber a 320 px. */
	.numero {
		font-size: clamp(2rem, 1.6rem + 1.6vw, 3rem);
		font-weight: 800;
		line-height: 1;
		letter-spacing: -0.02em;
		font-variant-numeric: tabular-nums;
	}

	.unidad {
		font-size: 0.875rem;
		font-weight: 600;
		line-height: 1.2;
		letter-spacing: 0.02em;
	}

	/* Con movimiento reducido no hay segundos que cambien: la cuenta se actualiza cada minuto. */
	@media (prefers-reduced-motion: reduce) {
		.casilla-segundos {
			display: none;
		}
	}

	.detalle {
		font-size: 1rem;
		line-height: 1.4;
	}

	.detalle:empty {
		display: none;
	}

	.cuenta :global(.flecha) {
		flex-shrink: 0;
		color: var(--color-verd-bosc);
	}

	/* Sin enlace (Properament, también cuando el script quita el `href`) no hay flecha. */
	.cuenta:not([href]) :global(.flecha) {
		display: none;
	}

	/* Escritorio: una fila como el boceto, con la marca a un lado, el número en medio y la fecha al otro. */
	@media (min-width: 48rem) {
		.datos {
			flex: 1;
			grid-template-columns: 1fr auto 1fr;
			align-items: center;
			gap: var(--espacio-6);
		}

		.detalle {
			justify-self: end;
			text-align: right;
		}
	}
</style>
