---
/**
 * "Places i equips" de un evento (C-04, historia 2, diseno.md §2): un bloque por categoría con
 * sus plazas libres y los equipos confirmados, y debajo el segundo "Inscriure's".
 *
 * Al construir la web solo deja la estructura, escondida: `eventos-cliente.ts` pide los equipos a
 * la fuente elegida (`FuenteEquipos`), rellena las plantillas `<template>` de aquí y la enseña. Los
 * textos salen de este archivo (diccionario por idioma), no del script.
 *
 * - Fuente `ninguna` (producción antes de A-14): no sale nada, ni el segundo botón (FR-015).
 * - Lista retirada (FR-040): tampoco sale nada.
 * - Fuente `prueba` (solo local y vistas previas): la página incrusta al construir únicamente los
 *   equipos YA en forma pública; nunca las filas en crudo (SC-003).
 * - El build falla con `prueba` en producción o con `supabase` sin configurar (FR-035).
 */
import type { DatosEvento } from './tipos';
import BotoInscripcio from './BotoInscripcio.astro';
import { type EstadoInscripcion, listaRetirada, ultimaJornada } from '../../lib/eventos/estado';
import { validarEntornoFuente } from '../../lib/eventos/fuente-equipos';
import { jsonLdComoTexto } from '../../lib/eventos/json-ld';
import type { Idioma } from '../textos-navegacion';
import { t } from '../textos-eventos';

interface Props {
	lang: Idioma;
	evento: DatosEvento;
	estado: EstadoInscripcion;
}

const { lang, evento, estado } = Astro.props;
const eventoId = Astro.params.evento;

// El entorno se valida siempre, aunque luego no se enseñe nada: así un error de configuración
// rompe el build en vez de publicarse sin avisar.
const fuente = validarEntornoFuente({
	PUBLIC_FUENTE_EQUIPOS: import.meta.env.PUBLIC_FUENTE_EQUIPOS,
	PUBLIC_SUPABASE_URL: import.meta.env.PUBLIC_SUPABASE_URL,
	PUBLIC_SUPABASE_ANON_KEY: import.meta.env.PUBLIC_SUPABASE_ANON_KEY,
	CONTEXT: process.env.CONTEXT,
});
const mostrar = fuente !== 'ninguna' && !listaRetirada(evento, new Date());

let equiposIncrustados: string | null = null;
if (mostrar && fuente === 'prueba') {
	// Import dinámico: los datos de prueba solo se cargan con esta fuente.
	const { equiposPublicosDePrueba } = await import('../../lib/eventos/datos-prueba');
	// Para ver en local los jugadores del Forms (interruptor FR-041 encendido).
	const jugadoresFormsPublicables = process.env.PRUEBA_JUGADORES_FORMS_PUBLICABLES === 'true';
	equiposIncrustados = jsonLdComoTexto(equiposPublicosDePrueba(jugadoresFormsPublicables));
}
---

{
	mostrar && (
		<div
			class="equipos"
			data-equipos
			data-evento-id={eventoId}
			data-ultima-jornada={ultimaJornada(evento)}
			hidden
		>
			<section class="bloque" aria-labelledby="titol-places-equips">
				<h2 id="titol-places-equips">{t(lang, 'placesIEquips')}</h2>

				<p class="aviso" data-error hidden>
					{t(lang, 'errorCargaEquipos')}
				</p>
				<p class="primero" data-sin-equipos hidden>
					{t(lang, 'sinEquipos')}
				</p>

				<div class="categorias" data-categorias>
					{evento.categorias.map((categoria) => (
						<section
							class="categoria"
							data-categoria={categoria.id}
							data-max-equipos={categoria.maxEquipos}
							aria-labelledby={`titol-categoria-${categoria.id}`}
						>
							<h3 id={`titol-categoria-${categoria.id}`}>{categoria.nombre[lang]}</h3>
							<p class="nacidos">
								{t(lang, 'nascuts')}: {categoria.nacidos[lang]}
							</p>
							<p class="plazas" data-plazas />
							<p class="espera" data-espera hidden>
								{t(lang, 'llistaEspera')}
							</p>
							<h4 class="rotulo" data-rotulo hidden>
								{t(lang, 'equipsInscrits')}
							</h4>
							<ul class="lista-equipos" data-lista-equipos />
						</section>
					))}
				</div>
			</section>

			<div class="segundo-boton">
				<BotoInscripcio
					lang={lang}
					estado={estado}
					nombreEvento={evento.nombre[lang]}
					inscripcion={evento.inscripcion}
				/>
			</div>

			<span
				hidden
				data-textos
				data-texto-plazas={t(lang, 'placesLliures')}
				data-texto-completa={t(lang, 'completa')}
				data-texto-un-jugador={t(lang, 'unJugador')}
				data-texto-n-jugadores={t(lang, 'nJugadores')}
			/>

			<template data-plantilla-equipo>
				<li class="equipo">
					<details>
						<summary>
							<span class="nombre-equipo" data-nombre />
							<span class="num-jugadores" data-num-jugadores />
						</summary>
						<ul class="jugadores" data-jugadores />
					</details>
				</li>
			</template>

			<template data-plantilla-equipo-simple>
				<li class="equipo equipo-simple">
					<span class="nombre-equipo" data-nombre />
				</li>
			</template>

			<template data-plantilla-jugador>
				<li class="jugador">
					<span data-nombre />
					<span class="dorsal" data-dorsal>
						<span class="punt" aria-hidden="true" />
						<span class="solo-lector">{t(lang, 'dorsal')} </span>
						<span data-valor-dorsal />
					</span>
					<span class="capita" data-capita>
						{t(lang, 'capita')}
					</span>
				</li>
			</template>

			{equiposIncrustados !== null && (
				<script type="application/json" data-equipos-publicos={eventoId} set:html={equiposIncrustados} />
			)}
		</div>
	)
}

<style>
	.equipos {
		display: grid;
		gap: var(--espacio-6);
		margin-top: var(--espacio-12);
	}

	h2 {
		margin: 0 0 var(--espacio-4);
		font-size: clamp(1.5rem, 1.25rem + 1vw, 2rem);
	}

	.aviso,
	.primero {
		max-width: 60ch;
		margin: 0 0 var(--espacio-4);
		font-weight: 600;
	}

	.categorias {
		display: grid;
		gap: var(--espacio-4);
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
		align-items: start;
	}

	/* Plano Herba clara: lo que está más cerca se distingue por el color, no por sombra (DESIGN.md). */
	.categoria {
		padding: var(--espacio-4) var(--espacio-4) var(--espacio-2);
		background: var(--color-herba-clara);
		border-radius: var(--radio-boton);
	}

	h3 {
		margin: 0;
		font-size: 1.25rem;
	}

	.nacidos {
		margin: var(--espacio-1) 0 var(--espacio-3);
	}

	.plazas {
		margin: 0;
		color: var(--color-verd-bosc);
		font-size: 1.5rem;
		font-weight: 800;
		line-height: 1.2;
	}

	.espera {
		margin: var(--espacio-1) 0 0;
		font-weight: 600;
	}

	.rotulo {
		margin: var(--espacio-4) 0 var(--espacio-1);
		font-size: 1rem;
		font-weight: 600;
		color: var(--color-tinta);
	}

	.lista-equipos {
		margin: 0;
		padding: 0;
		list-style: none;
		border-top: 1px solid var(--color-linea);
	}

	.lista-equipos:empty {
		display: none;
	}

	/* Las plantillas se clonan desde el script: sus estilos tienen que llegar a lo clonado. */
	.equipo {
		border-bottom: 1px solid var(--color-linea);
	}

	.equipo-simple {
		display: flex;
		align-items: center;
		min-height: var(--zona-tactil);
		padding: var(--espacio-2) 0;
	}

	.nombre-equipo {
		overflow-wrap: anywhere;
		color: var(--color-verd-bosc);
		font-weight: 600;
		line-height: 1.35;
	}

	/* Cada equipo es una fila de al menos 44 px con un "+" que pasa a "−" al abrirse. */
	summary {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--espacio-3);
		min-height: var(--zona-tactil);
		padding: var(--espacio-2) var(--espacio-8) var(--espacio-2) 0;
		list-style: none;
		cursor: pointer;
	}

	summary::-webkit-details-marker {
		display: none;
	}

	summary::before,
	summary::after {
		content: '';
		position: absolute;
		top: 50%;
		right: var(--espacio-2);
		width: 0.875rem;
		height: 2px;
		background: var(--color-verd-bosc);
	}

	summary::after {
		transform: rotate(90deg);
	}

	details[open] > summary::after {
		display: none;
	}

	summary:hover .nombre-equipo {
		text-decoration: underline;
		text-decoration-thickness: 2px;
	}

	.num-jugadores {
		flex-shrink: 0;
		font-size: 0.9375rem;
	}

	.jugadores {
		margin: 0;
		padding: 0 0 var(--espacio-3);
		list-style: none;
	}

	.jugador {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		column-gap: var(--espacio-1);
		padding: var(--espacio-1) 0;
	}

	.dorsal {
		display: inline-flex;
		align-items: center;
	}

	/* Punto volado dibujado con CSS: el "·" de Overpass se dibuja con un espaciado raro. */
	.punt {
		flex-shrink: 0;
		width: 0.14em;
		height: 0.14em;
		margin: 0 0.3em 0 0.2em;
		background: currentColor;
	}

	/* "capità" va en texto, no solo con un color o un icono. */
	.capita {
		margin-left: var(--espacio-2);
		padding: 0 var(--espacio-2);
		background: var(--color-boira);
		border-radius: var(--radio-senal);
		color: var(--color-verd-bosc);
		font-size: 0.875rem;
		font-weight: 600;
		line-height: 1.5;
	}

	.segundo-boton {
		max-width: 28rem;
	}

	/* Al final para ganar a los `display` de arriba: el script esconde y enseña con `hidden`. */
	[hidden] {
		display: none;
	}
</style>
