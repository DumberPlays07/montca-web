---
/**
 * Primera pantalla de la página de un evento: "Cartell de les dues jornades"
 * (C-04, diseno.md §2 y boceto-cartell.html). En el móvil cabe entera sin scroll:
 * marca, título, jornadas, deportes y precio, lugar, estado e Inscriure's.
 * En escritorio se reparte en dos columnas: el cartel a la izquierda y la acción a la derecha.
 */
import BotoInscripcio from './BotoInscripcio.astro';
import ComArribar from './ComArribar.astro';
import EstatInscripcio from './EstatInscripcio.astro';
import type { DatosEvento } from './tipos';
import type { EstadoInscripcion } from '../../lib/eventos/estado';
import { diaDeLaSemana, numeralJornada } from '../../lib/eventos/fechas';
import type { Idioma } from '../textos-navegacion';
import { t } from '../textos-eventos';

interface Props {
	lang: Idioma;
	evento: DatosEvento;
	estado: EstadoInscripcion;
}

const { lang, evento, estado } = Astro.props;
const { precio } = evento;
---

<section class="cartell" aria-labelledby="titol-esdeveniment">
	<div class="cartell-cap">
		<p class="kicker">
			<span>{evento.marca}</span>
			<span class="punt" aria-hidden="true" />
			<span class="solo-lector">, </span>
			<span>{t(lang, 'esdeveniment')}</span>
		</p>
		<h1 id="titol-esdeveniment">{evento.nombre[lang]}</h1>

		<ol class="jornades">
			{
				evento.jornadas.map((jornada) => (
					<li class="jornada">
						<time class="numeral" datetime={jornada.fecha}>
							<span>{numeralJornada(jornada.fecha).dia}</span>
							<span class="punt" aria-hidden="true" />
							<span class="solo-lector">/</span>
							<span>{numeralJornada(jornada.fecha).mes}</span>
						</time>
						<span class="dia">
							{diaDeLaSemana(jornada.fecha, lang)}, {jornada.nombre[lang]}
						</span>
					</li>
				))
			}
		</ol>
	</div>

	<div class="cartell-accio">
		<p class="esports">
			{evento.deportes[lang]}
			<span class="preu">
				{precio.texto[lang]}{!precio.confirmado && ` (${t(lang, 'precioPendiente')})`}.
			</span>
		</p>

		<ComArribar lang={lang} lugar={evento.lugar} />

		<div class="estat-i-boto">
			<EstatInscripcio
				lang={lang}
				estado={estado}
				apertura={evento.inscripcion.apertura}
				cierre={evento.inscripcion.cierre}
			/>
			<BotoInscripcio
				lang={lang}
				estado={estado}
				nombreEvento={evento.nombre[lang]}
				inscripcion={evento.inscripcion}
			/>
		</div>
	</div>
</section>

<style>
	.cartell {
		display: grid;
		gap: var(--espacio-4);
	}

	/* Con el texto ampliado, la segunda parte baja entera en vez de partir "Montca Sports". */
	.kicker {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0 0.4em;
		margin: 0;
		color: var(--color-verd-fulla);
		font-size: 0.875rem;
		font-weight: 600;
		letter-spacing: 0.02em;
	}

	/* Display (DESIGN.md): 800, de ~2.25rem en el móvil a ~3.5rem en escritorio. */
	h1 {
		margin: var(--espacio-1) 0 0;
		font-size: clamp(2.25rem, 1.5rem + 3vw, 3.5rem);
		line-height: 1.05;
		letter-spacing: -0.01em;
	}

	.jornades {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(8.5rem, 1fr));
		gap: var(--espacio-3);
		margin: var(--espacio-4) 0 0;
		padding: 0;
		list-style: none;
	}

	/* La raya Verd bosc encima de cada fecha es el "bancal" del mapa. */
	.jornada {
		display: grid;
		gap: var(--espacio-1);
		padding-top: var(--espacio-2);
		border-top: 5px solid var(--color-verd-bosc);
	}

	.numeral {
		display: flex;
		align-items: center;
		color: var(--color-verd-bosc);
		font-size: clamp(3rem, 2.4rem + 2.5vw, 4rem);
		font-weight: 800;
		line-height: 1;
		letter-spacing: -0.02em;
		font-variant-numeric: tabular-nums;
	}

	/* Punto volado dibujado con CSS: el "·" de Overpass se dibuja con un espaciado raro. */
	.punt {
		flex-shrink: 0;
		width: 0.14em;
		height: 0.14em;
		margin: 0 0.12em;
		background: currentColor;
	}

	.dia {
		font-size: 0.9375rem;
		font-weight: 600;
		line-height: 1.3;
	}

	.cartell-accio {
		display: grid;
		gap: var(--espacio-3);
	}

	/* Plano Pedra: superficie cálida puntual (DESIGN.md, Tertiary). */
	.esports {
		margin: 0;
		padding: var(--espacio-3);
		background: var(--color-pedra);
		border-radius: var(--radio-senal);
		line-height: 1.45;
	}

	.preu {
		display: block;
		margin-top: var(--espacio-1);
		font-weight: 600;
	}

	.estat-i-boto {
		display: grid;
		gap: var(--espacio-3);
		margin-top: var(--espacio-1);
	}

	/* Escritorio: el cartel a la izquierda y la acción a la derecha, alineados arriba. */
	@media (min-width: 64rem) {
		.cartell {
			grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
			align-items: start;
			gap: var(--espacio-12);
		}

		.cartell-accio {
			gap: var(--espacio-4);
		}
	}
</style>
