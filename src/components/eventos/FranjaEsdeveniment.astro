---
/**
 * Franja de un evento en la portada (C-04, historia 3, diseno.md §4): banda Verd bosc a
 * todo el ancho que lleva a la página del evento mientras sus inscripciones están abiertas.
 *
 * Al construir la web solo sale si hay un evento "obertes" (el que cierra antes, FR-030).
 * En el navegador, `eventos-cliente.ts` la vuelve a calcular con la hora del momento y la
 * oculta en cuanto deja de estar abierto (FR-029), sin volver a publicar.
 */
import { getCollection } from 'astro:content';
import { eventoParaFranja } from '../../lib/eventos/franja';
import { diaMes } from '../../lib/eventos/fechas';
import Icono from '../Icono.astro';
import { type Idioma, ruta } from '../textos-navegacion';
import { rellenar, t } from '../textos-eventos';

interface Props {
	lang: Idioma;
}

const { lang } = Astro.props;

const eventos = (await getCollection('eventos')).map((entrada) => ({ id: entrada.id, ...entrada.data }));
const evento = eventoParaFranja(eventos, new Date());
---

{
	evento && (
		<a
			class="franja"
			href={`${ruta(lang, 'eventos')}${evento.id}/`}
			data-franja-evento
			data-apertura={evento.inscripcion.apertura}
			data-cierre={evento.inscripcion.cierre}
			data-cerrada-a-mano={String(evento.inscripcion.cerradaAMano)}
		>
			<span class="interior">
				<span class="textos">
					<span class="nombre">{evento.nombre[lang]}</span>
					{/* Sin este espacio, el lector de pantalla junta el nombre y el estado en una palabra. */}
					{' '}
					<span class="estat">
						<span class="pintura" aria-hidden="true" />
						{rellenar(t(lang, 'estadoObertes'), { fecha: diaMes(evento.inscripcion.cierre) })}
					</span>
				</span>
				<Icono nombre="seguir" clase="flecha" />
			</span>
		</a>
	)
}

<script>
	import '../../scripts/eventos-cliente';
</script>

<style>
	.franja {
		display: block;
		background: var(--color-verd-bosc);
		color: var(--color-boira);
		text-decoration: none;
		transition: background-color var(--transicion);
	}

	/* `display: block` taparía el atributo `hidden` que pone el script. */
	.franja[hidden] {
		display: none;
	}

	.interior {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--espacio-4);
		max-width: var(--ancho-maximo);
		min-height: var(--zona-tactil);
		margin: 0 auto;
		padding: var(--espacio-3) var(--margen-lateral);
		box-sizing: border-box;
	}

	.textos {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		column-gap: var(--espacio-4);
		row-gap: var(--espacio-1);
	}

	.nombre {
		font-weight: 800;
		font-size: 1.125rem;
		line-height: 1.2;
	}

	.estat {
		display: inline-flex;
		align-items: flex-start;
		gap: var(--espacio-2);
		font-weight: 600;
		line-height: 1.3;
	}

	/* Marca de pintura (DESIGN.md, Shapes) en Teula clara: regla del fondo oscuro.
	   Centrada en la primera línea, para que siga junto al texto si este ocupa dos. */
	.pintura {
		flex-shrink: 0;
		width: 1.25rem;
		height: 0.375rem;
		margin-top: calc((1.3em - 0.375rem) / 2);
		background: var(--color-teula-clara);
	}

	.franja :global(.flecha) {
		color: var(--color-teula-clara);
	}

	.franja:hover {
		background: var(--color-tinta);
	}

	.franja:hover .nombre {
		text-decoration: underline;
		text-decoration-thickness: 2px;
		text-underline-offset: 0.15em;
	}

	/* El contorno va por dentro: por fuera se saldría de la banda y quedaría sobre la cabecera. */
	.franja:focus-visible {
		outline-color: var(--color-teula-clara);
		outline-offset: -5px;
		border-radius: 0;
	}
</style>
